# Environment Variables for WorkTrail AI

# Database: SQLite for instant local zero-config run. 
# For PostgreSQL in production, change schema.prisma provider to "postgresql" and use:
# DATABASE_URL="postgresql://user:password@localhost:5432/worktrail?schema=public"
DATABASE_URL="file:./dev.db"

# Authentication secret
JWT_SECRET="worktrail-ai-secure-secret-token-key-change-in-prod"
NEXTAUTH_SECRET="worktrail-ai-secure-secret-token-key-change-in-prod"
NEXTAUTH_URL="http://localhost:3000"

# Optional: OpenAI API Key for live AI summaries and OCR analysis
# When omitted, WorkTrail AI uses its smart embedded AI analyzer engine seamlessly
OPENAI_API_KEY=""

# Optional: Cloudinary configuration for external file storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
